---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.title | xml_escape }} · Research</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/research/' | absolute_url }}" rel="alternate" type="text/html" />
  <id>{{ '/research/' | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name | xml_escape }}</name><uri>{{ site.github_url }}</uri></author>
  {% assign articles = site.research | sort: 'date' | reverse %}{% for item in articles limit: 20 %}
  <entry>
    <title>{{ item.title | xml_escape }}</title>
    <link href="{{ item.url | absolute_url }}" rel="alternate" type="text/html" />
    <id>{{ item.url | absolute_url }}</id>
    <published>{{ item.date | date_to_xmlschema }}</published>
    <updated>{{ item.last_modified_at | default: item.date | date_to_xmlschema }}</updated>
    <summary type="text">{{ item.description | xml_escape }}</summary>
    {% for tag in item.tags %}<category term="{{ tag | xml_escape }}" />{% endfor %}
  </entry>
  {% endfor %}
</feed>
